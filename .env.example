# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Used for sending invites, writing api_logs/integration_health, webhooks and cron jobs.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public URL of the deployed app (used in sign-in / invite email links when the request has no Origin header)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Later phases (not used yet) ---
