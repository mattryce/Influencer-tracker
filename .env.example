# META_APP_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# YouTube Data API (Phase 3)
# YOUTUBE_API_KEY=
# Shopify (Phase 4)
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# Anthropic vision for screenshot OCR (Phase 6)
# ANTHROPIC_API_KEY=
# Gmail alerts (Phase 5)
# GMAIL_SMTP_USER=
# GMAIL_SMTP_APP_PASSWORD=
# ALERT_EMAIL_TO=
